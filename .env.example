# ArtıGıda Production Environment Variables Example
# Copy this file to .env and adjust the values before deploying.

# --- Database Configurations ---
POSTGRES_DB=artigida
POSTGRES_USER=artigida_app
# Change this to a secure random password in production!
POSTGRES_PASSWORD=artigida_secure_password_here

# --- Authentication ---
# JWT Secret Key - Make sure this is a secure, long string (at least 32 characters)
JWT_SECRET_KEY=generate_a_long_random_string_here_for_jwt_security

# --- AI Integration (OpenRouter) ---
# Your OpenRouter API Key for AI-based shelf life and category predictions
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash

# --- CORS Configurations ---
# Allowed domains (e.g., https://yourdomain.com). Use * to allow all (or leave as * if behind Nginx gateway)
CORS_ORIGINS=*
